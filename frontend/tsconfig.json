{
  "compilerOptions": {
    // "@/x" is src/x, from anywhere. Nesting the pages by how they are reached
    // put real screens three and four levels down, and "../../../design-system"
    // says nothing about what it imports while quietly encoding where the file
    // that imports it happens to sit — so it breaks on every move. Vite and
    // Vitest are given the same alias; all three have to agree or the checker
    // and the bundler disagree about what resolves.
    // Relative, and no baseUrl: TypeScript 6 removed baseUrl and requires the
    // target to start with "./".
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Vite and Vitest strip types rather than compile them, so TypeScript
    // syntax that has to emit code — enums, namespaces, parameter
    // properties — would type-check here and be missing at runtime. This
    // rejects it at the point it is written instead.
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
