{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Vite and Vitest strip types rather than compile them, so TypeScript
    // syntax that has to emit code — enums, namespaces, parameter
    // properties — would type-check here and be missing at runtime. This
    // rejects it at the point it is written instead.
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
