# Build output.
# NOT /build/ — spec/rollout/00 §0.1 designates build/ for packaging, icons and
# notarisation scripts, which are source and must be committed.
/bin/
/build/bin/
/dist/
# GoLand writes run-configuration output here. It reached the repository once,
# as a 90MB binary, which is most of what a clone now costs to download.
/out/
# Anchored. A bare `portcloak` matches any path component at any depth, which
# silently swallowed cmd/portcloak/ — the application's entry point was ignored
# and never committed, so a fresh clone could not build the binary at all.
/portcloak
*.exe
# Windows resource objects are generated from build/windows/winres.json during
# packaging and linked automatically by the Go toolchain if left lying around.
*.syso

# Go
*.test
*.out
vendor/

# Wails
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/.vite/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Local runtime data — never committed
.portcloak/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Snapshot bundles and any exported realm material.
# An unencrypted .pck holds unmasked client secrets and private signing keys,
# so the extension here must match spec/06 §6.1 exactly.
*.pck
*.pck.age
*.manifest.json
*.sha256
/testdata/snapshots/
/testdata/kc-output/*.dump

# Lunacy autosave / lock files
*.sketch.lock
*~
